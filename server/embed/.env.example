# copy to .env (never commit .env)
# make a token:  openssl rand -hex 32
EMBED_TOKEN=

# which server ngrok forwards to
#   Docker on CPU (default):           COMPOSE_PROFILES=cpu   NGROK_UPSTREAM=embed:8080
#   Mac fast mode (./mac-native.sh):   COMPOSE_PROFILES=      NGROK_UPSTREAM=host.docker.internal:8081
COMPOSE_PROFILES=cpu
NGROK_UPSTREAM=embed:8080

# ngrok (https://dashboard.ngrok.com)
#   NGROK_AUTHTOKEN: Getting Started › Your Authtoken
#   NGROK_DOMAIN:    optional, e.g. something.ngrok-free.app — empty = ngrok picks the URL (may change on restart)
#   NGROK_ALLOW_IPS: public IP(s) of the office, comma-separated CIDRs, e.g. 203.0.113.10/32
#                    find it on the Windows machine at https://ifconfig.me — empty = anyone with the URL can try
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_ALLOW_IPS=

# defaults — change only if you know why (a different model means DocAsk re-embeds everything)
# EMBED_MODEL=BAAI/bge-m3
# EMBED_MAX_TOKENS=2048
# EMBED_BATCH=16
