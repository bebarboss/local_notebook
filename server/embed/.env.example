# copy to .env (never commit .env)
# make a token:  openssl rand -hex 32
EMBED_TOKEN=

# database (index + chats): make a password with  openssl rand -hex 24
POSTGRES_PASSWORD=
# mac-native mode only (the app runs outside Docker): same password as above
# DATABASE_URL=postgresql://docask:<POSTGRES_PASSWORD>@127.0.0.1:5432/docask

# which server the Cloudflare tunnel forwards to
#   Docker on CPU (default):           COMPOSE_PROFILES=cpu   TUNNEL_UPSTREAM=embed:8080
#   Mac fast mode (./mac-native.sh):   COMPOSE_PROFILES=      TUNNEL_UPSTREAM=host.docker.internal:8081
COMPOSE_PROFILES=cpu
TUNNEL_UPSTREAM=embed:8080

# defaults — change only if you know why (a different model means DocAsk re-embeds everything)
# EMBED_MODEL=BAAI/bge-m3
# EMBED_MAX_TOKENS=2048
# EMBED_BATCH=16
